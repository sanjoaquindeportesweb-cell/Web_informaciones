DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Plataforma de trámites (talleres y arriendo de canchas).
# El portal solo informa y deriva hacia allá. Sin definir, apunta al despliegue
# de desarrollo de la plataforma; en producción hay que poner el dominio real o
# los enlaces de «Inscríbete en talleres» mandan al entorno de pruebas.
# NEXT_PUBLIC_URL_PLATAFORMA=https://plataforma.example.cl

# Almacenamiento de imágenes.
# Sin S3_BUCKET las subidas van al disco local (media/), que es lo correcto en
# desarrollo. En hosting serverless el disco es de solo lectura: ahí S3_BUCKET
# es obligatorio o el panel no podrá subir fotos.
# S3_BUCKET=
# S3_REGION=us-east-1
# Solo para desarrollo. En AWS se omiten y el SDK usa el rol IAM del entorno.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Envío de correo (Resend).
# Sin estas dos, Payload escribe los correos en la consola en vez de enviarlos.
# Es lo correcto en desarrollo; en producción significa que la recuperación de
# contraseña del panel no le llega a nadie, y sin dar ningún error.
# El remitente tiene que ser del dominio verificado en Resend.
# RESEND_API_KEY=
# EMAIL_REMITENTE=contacto@example.cl

# Publicación programada.
# EJECUTAR_JOBS=true activa el cron interno; úsalo únicamente donde haya un
# proceso Node persistente. En serverless déjalo sin definir y llama
# POST /api/payload-jobs/run desde un cron externo con CRON_SECRET.
# EJECUTAR_JOBS=true
# CRON_SECRET=
