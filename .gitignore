# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# Permisos que cada quien fue aprobando en su propia máquina: no describen el
# proyecto y arrastran lo que se haya tecleado en un comando aprobado, que en
# esta máquina incluía una contraseña de prueba en texto plano. `launch.json`,
# en cambio, sí se versiona: es la configuración del servidor de desarrollo y
# sirve igual para todo el equipo.
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

# Lo genera el build de Amplify con los secretos del panel para que el runtime
# SSR los vea. Si se compila en local, aquí queda una copia en texto plano.
.env.production

/media

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
